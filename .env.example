PORT=3000
DATA_DIR=.data
# Required in production only before explicit multi-group owner bootstrap.
# Ignored for login after bootstrap. See docs/multi-group-platform.md.
HOST_PASSWORD=
# FF_ADMIN_EMAIL and FF_ADMIN_PASSWORD are temporary operator CLI inputs only.
# Do not save those credentials here or in persistent application settings.
# Exact public origins in production, comma-separated when using multiple domains.
APP_ORIGIN=http://localhost:3000
NODE_ENV=development
# Advertising stays off until approved and consent setup is verified. See docs/advertising.md.
ADS_ENABLED=false
ADSENSE_CLIENT=
ADSENSE_RULES_SLOT=
ADS_CONSENT_READY=false
# Google Cast custom receiver application ID (optional). See docs/google-cast.md.
CAST_APP_ID=
